# NextAuth — NEXTAUTH_URL must match the URL the app runs on.
# Local: http://localhost:3000 — Production: your https Vercel URL.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=genera-un-secreto-aleatorio-aqui-min-32-chars

# Postgres connection string (Neon in production, local Docker in dev).
# When set, login is verified against the `users` table (bcrypt).
# When unset, the app falls back to the demo credentials below.
# Run `npm run db:setup` once after setting this to create the table + seed users.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Demo fallback — only used when DATABASE_URL is NOT set (local/offline).
# AUTH_DEMO_EMAIL=demo@rehub.do
# AUTH_DEMO_PASSWORD=demo123
